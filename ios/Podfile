$RNFirebaseAsStaticFramework = true
$RNFirebaseDisableSPM = true

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Pinned explicitly rather than min_ios_version_supported so the Podfile and the Xcode
# project's Minimum Deployment cannot silently diverge (doc 21 §2).
platform :ios, '15.1'
use_modular_headers!
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'DyslexiaApp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Phase 3, Branch 21: Only the two permission handlers the app actually uses.
  # Adding every handler bloats the binary and can trigger App Store questions.
  permissions_path = '../node_modules/react-native-permissions/ios'
  pod 'RNPermissions', :path => permissions_path
  pod 'Permission-Camera', :path => "#{permissions_path}/Camera"
  pod 'Permission-LocationWhenInUse', :path => "#{permissions_path}/LocationWhenInUse"

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
